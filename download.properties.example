# Copia este archivo a "download.properties" (sin el .example) y rellena la URL
# real donde subiste el paquete completo comprimido (cuba_full_package.zip).
# download.properties NO se versiona (está en .gitignore) porque es específico de tu
# despliegue.
#
# Cualquier hosting de archivos estáticos sirve: GitHub Releases, un bucket S3/R2, 
# tu propio servidor, etc. Debe ser un enlace de descarga DIRECTA.

CUBA_FULL_PACKAGE_URL=https://tu-servidor.com/cuba_full_package.zip

# Opcional — tu propio servidor de rutas compatible con la API de OSRM. Déjalo
# vacío si no quieres modo de rutas online.
ONLINE_ROUTING_BASE_URL=
