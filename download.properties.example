# Copia este archivo a "download.properties" (sin el .example) y rellena las URLs
# reales donde subiste cuba.mbtiles y graph-cache.zip (ver SETUP_MAPA_OFFLINE.md, Fase 3).
# download.properties NO se versiona (está en .gitignore) porque es específico de tu
# despliegue.
#
# Cualquier hosting de archivos estáticos sirve: GitHub Releases (gratis, hasta 2GB por
# archivo), un bucket S3/R2 propio, tu propio servidor, etc. Deben ser enlaces de
# descarga DIRECTA (que respondan con el archivo, no una página HTML).

CUBA_MBTILES_URL=https://ejemplo.com/cuba.mbtiles
CUBA_GRAPH_CACHE_ZIP_URL=https://ejemplo.com/graph-cache.zip
CUBA_POIS_SQLITE_URL=https://ejemplo.com/pois.sqlite

# Opcional (Fase 4) — tu propio servidor de rutas compatible con la API de OSRM. Déjalo
# vacío si no quieres modo de rutas online (la app funciona igual, ver SETUP_MAPA_OFFLINE.md).
ONLINE_ROUTING_BASE_URL=
