{
  "version": 8,
  "name": "Cuba GPS Offline",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "tiles": ["__TILE_SERVER_BASE_URL__/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 14
    }
  },
  "sprite": "",
  "glyphs": "__TILE_SERVER_BASE_URL__/fonts/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#0e1a12" } },
    {
      "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "paint": { "fill-color": "#0e3a52" }
    },
    {
      "id": "landcover", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "paint": { "fill-color": "#16321f", "fill-opacity": 0.6 }
    },
    {
      "id": "landuse-residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": { "fill-color": "#1c2a1c", "fill-opacity": 0.5 }
    },
    {
      "id": "road-path", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "path"],
      "paint": { "line-color": "#4a4a3a", "line-width": 1 }
    },
    {
      "id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "paint": { "line-color": "#5a5a52", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.5, 16, 2] }
    },
    {
      "id": "road-secondary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#caa24a", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 16, 5] }
    },
    {
      "id": "road-primary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#e0a83c", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.5, 16, 7] }
    },
    {
      "id": "road-motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", "class", "motorway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#ff8a3c", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 2, 16, 9] }
    },
    {
      "id": "buildings-3d",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "paint": {
        "fill-extrusion-color": "#8a8578",
        "fill-extrusion-height": ["coalesce", ["get", "render_height"], 6],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], 0],
        "fill-extrusion-opacity": 0.85
      }
    },
    {
      "id": "road-name-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-size": 11,
        "text-letter-spacing": 0.05
      },
      "paint": { "text-color": "#f2ede1", "text-halo-color": "#0e1a12", "text-halo-width": 1.2 }
    },
    {
      "id": "housenumber-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "housenumber",
      "minzoom": 17,
      "layout": {
        "text-field": ["get", "housenumber"],
        "text-size": 9
      },
      "paint": { "text-color": "#cfcfcf", "text-halo-color": "#0e1a12", "text-halo-width": 1 }
    },
    {
      "id": "poi-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "poi",
      "minzoom": 15,
      "layout": {
        "text-field": ["get", "name"],
        "text-size": 11,
        "text-offset": [0, 1.0]
      },
      "paint": { "text-color": "#f2ede1", "text-halo-color": "#0e1a12", "text-halo-width": 1.2 }
    },
    {
      "id": "place-labels", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "layout": { "text-field": ["get", "name"], "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 12, 16] },
      "paint": { "text-color": "#ffffff", "text-halo-color": "#000000", "text-halo-width": 1.4 }
    }
  ]
}
